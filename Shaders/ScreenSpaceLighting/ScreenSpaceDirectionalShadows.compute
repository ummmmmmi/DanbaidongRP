RWStructuredBuffer<uint> g_TileList;

#if defined(SHADOW_CLASSIFY_TILES)
TEXTURE2D_ARRAY(_DirShadowmapTexture);

RW_TEXTURE2D(float, _SSDirShadowmapTexture);
RW_TEXTURE2D(float, _TracedShadowTexture);
RW_TEXTURE2D(float3, _ShadowMomentstexture);
RWBuffer<uint> g_DispatchIndirectBuffer;

// Ray tracing indirect dispatch args
RWBuffer<uint> _ShadowRayIndirectBuffer;
RWStructuredBuffer<uint> _ShadowRayCoordBuffer;

TEXTURE2D_X(_GBuffer0); // for receive shadow flag.
TEXTURE2D_X(_GBuffer2); // for normal dot light.
TYPED_TEXTURE2D(uint2, _StencilTexture); // ndotl need exclude character

#elif defined(SHADOW_PCSS)
TEXTURE2D_ARRAY(_DirShadowmapTexture);

RW_TEXTURE2D(float, _PCSSTexture);

#elif defined(CONTACT_SHADOWS)
TEXTURE2D_X(_GBuffer0);
TEXTURE2D_X(_GBuffer2);
RW_TEXTURE2D(float, _SSDirShadowmapTexture);


#elif defined(SHADOW_BILATERAL_FILTER)
TEXTURE2D_X_FLOAT(_GBuffer2);

RW_TEXTURE2D(float, _BilateralTexture);

#endif

//--------------------------------------------------------------------------------------------------
// Helpers
//--------------------------------------------------------------------------------------------------

#define SCREENSPACE_SHADOWS_TILE_SIZE   (16)
#define SCREENSPACE_SHADOWS_GROUP_SIZE  (SCREENSPACE_SHADOWS_TILE_SIZE / 2)
#define SCREENSPACE_SHADOWS_THREADS     (64)


#define HIGH_PREFILTER_SAMPLE_COUNT     (32)
#define HIGH_BLOCKER_SAMPLE_COUNT       (16)
#define HIGH_PCSS_SAMPLE_COUNT          (32)
#define ULTRA_PREFILTER_SAMPLE_COUNT    (48)
#define ULTRA_BLOCKER_SAMPLE_COUNT      (32)
#define ULTRA_PCSS_SAMPLE_COUNT         (64)

// World space filter size.
#define FILTER_SIZE_PREFILTER           (0.3)
#define FILTER_SIZE_BLOCKER             (0.2)

#define DIR_LIGHT_PENUMBRA_WIDTH        _DirLightShadowPenumbraParams.x


int _CamHistoryFrameCount;
int _RasterShadowDenoiser;
float4 _ContactShadowParams0;
float4 _ContactShadowParams1;
int _ContactShadowSampleCount;


uint2 DecodeTileIndex(uint encoded)
{
    return uint2((encoded >> TILE_INDEX_SHIFT_X) & TILE_INDEX_MASK, (encoded >> TILE_INDEX_SHIFT_Y) & TILE_INDEX_MASK);
}

uint EncodeTileIndex(uint2 tileID)
{
    return (unity_StereoEyeIndex << TILE_INDEX_SHIFT_EYE) | (tileID.y << TILE_INDEX_SHIFT_Y) | (tileID.x << TILE_INDEX_SHIFT_X);
}

void InitializeDispatchThreadIdFromTileList(uint groupId, uint2 gThreadId, out uint2 tileCoord, out uint2 dThreadId)
{
    uint encodedTileIndex = g_TileList[groupId / 4];

    tileCoord = DecodeTileIndex(encodedTileIndex);
    dThreadId = tileCoord * SCREENSPACE_SHADOWS_TILE_SIZE
              + uint2(groupId & 1, (groupId >> 1) & 1) * SCREENSPACE_SHADOWS_GROUP_SIZE
              + gThreadId;
}

#if defined(SHADOW_CLASSIFY_TILES) || defined(SHADOW_PCSS)

float2 GetShadowNoise(uint2 coordSS, float3 shadowCoord, uint cascadeIndex)
{
    uint2 shadowmapSize = (uint2)_MainLightShadowmapSize.zw;
    uint2 stableNoiseCoord = (uint2)floor(saturate(shadowCoord.xy) * shadowmapSize * 4.0);
    stableNoiseCoord += uint2(cascadeIndex * 17, cascadeIndex * 31);

    uint2 noiseCoord = _RasterShadowDenoiser != 0 ? coordSS : stableNoiseCoord;
    float2 noiseVector = GetSpatiotemporalBlueNoiseVec2(noiseCoord) * 2.0 - 1.0;
    return noiseVector * rsqrt(max(dot(noiseVector, noiseVector), 1e-4));
}

float SampleHardDirectionalShadow(float3 shadowCoord, uint cascadeIndex)
{
    shadowCoord = ApplyMainLightReceiverBias(shadowCoord, cascadeIndex);
    float shadowMapDepth = SAMPLE_TEXTURE2D_ARRAY_LOD(_DirShadowmapTexture, sampler_PointClamp, shadowCoord.xy, cascadeIndex, 0).x;
    return COMPARE_DEVICE_DEPTH_CLOSER(shadowMapDepth, shadowCoord.z) ? 0.0 : 1.0;
}

float SamplePCFDirectionalShadow(float3 shadowCoord, uint cascadeIndex, half shadowQuality)
{
    // Low and Medium share the same cascade transform and receiver bias as Hard and PCSS.
    ShadowSamplingData samplingData = (ShadowSamplingData)0;
    samplingData.shadowOffset0 = _MainLightShadowOffset0;
    samplingData.shadowOffset1 = _MainLightShadowOffset1;
    samplingData.shadowmapSize = _MainLightShadowmapSize;
    samplingData.softShadowQuality = shadowQuality;
    float4 biasedShadowCoord = float4(ApplyMainLightReceiverBias(shadowCoord, cascadeIndex), cascadeIndex);
    float attenuation = 1.0;
    if (shadowQuality == SOFT_SHADOW_QUALITY_LOW)
        attenuation = SampleShadowmapArrayFilteredLowQuality(TEXTURE2D_ARRAY_SHADOW_ARGS(_DirShadowmapTexture, sampler_LinearClampCompare), biasedShadowCoord, samplingData);
    else
        attenuation = SampleShadowmapArrayFilteredMediumQuality(TEXTURE2D_ARRAY_SHADOW_ARGS(_DirShadowmapTexture, sampler_LinearClampCompare), biasedShadowCoord, samplingData);

    return attenuation;
}

void GetPCSSSampleCounts(out float prefilterSampleCount, out float blockerSampleCount, out float filterSampleCount)
{
    bool ultraQuality = _MainLightShadowParams.y >= SOFT_SHADOW_QUALITY_ULTRA;
    prefilterSampleCount = ultraQuality ? ULTRA_PREFILTER_SAMPLE_COUNT : HIGH_PREFILTER_SAMPLE_COUNT;
    blockerSampleCount = ultraQuality ? ULTRA_BLOCKER_SAMPLE_COUNT : HIGH_BLOCKER_SAMPLE_COUNT;
    filterSampleCount = ultraQuality ? ULTRA_PCSS_SAMPLE_COUNT : HIGH_PCSS_SAMPLE_COUNT;
}

float ClassifyPCSSShadow(float3 shadowCoord, uint cascadeIndex, float2 noiseJitter, float prefilterSampleCount, out bool needsPCSS)
{
    float texelSizeWS = _PerCascadePCSSData[cascadeIndex].y;
    float preFilterSize = max(FILTER_SIZE_PREFILTER / texelSizeWS, 1.0);
    float blockerCount = PreFilterSearch(prefilterSampleCount, preFilterSize, shadowCoord, cascadeIndex, noiseJitter);
    needsPCSS = blockerCount > 0.0 && blockerCount < prefilterSampleCount;
    return 1.0 - saturate(blockerCount / prefilterSampleCount);
}

float EvaluatePCSSShadow(float3 shadowCoord, uint cascadeIndex, float2 noiseJitter, float blockerSampleCount, float filterSampleCount)
{
    float texelSizeWS = _PerCascadePCSSData[cascadeIndex].y;
    float farToNear = _PerCascadePCSSData[cascadeIndex].z;

    float filterSize = max(FILTER_SIZE_BLOCKER / texelSizeWS, 1.0);
    float2 avgDepthAndCount = BlockerSearch(blockerSampleCount, filterSize, shadowCoord, noiseJitter, cascadeIndex);
    if (avgDepthAndCount.y == 0.0)
        return 1.0;

    float receiverDepth = ApplyMainLightReceiverBias(shadowCoord, cascadeIndex).z;
    float blockerDistance = min(abs(avgDepthAndCount.x - receiverDepth) * farToNear, 10.0);
    float maxPCSSoffset = blockerDistance / farToNear * 0.25;
    float pcssFilterSize = max(DIR_LIGHT_PENUMBRA_WIDTH * blockerDistance * 0.01 / texelSizeWS, 0.01);
    return PCSSFilter(filterSampleCount, pcssFilterSize, shadowCoord, noiseJitter, cascadeIndex, maxPCSSoffset);
}

#elif defined(SHADOW_BILATERAL_FILTER)


#endif

//--------------------------------------------------------------------------------------------------
// Implementation Classify Tiles
//--------------------------------------------------------------------------------------------------

#if defined(SHADOW_CLASSIFY_TILES)

groupshared uint gTileCount = 0;

// Dispatch size is 16*16 (tile size), each group has 64 threads, each thread handle 4 piexels.
[numthreads(SCREENSPACE_SHADOWS_THREADS, 1, 1)]
void CLASSIFY_TILES(uint3 dispatchThreadId : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex, uint3 groupID : SV_GroupID)
{
    uint2 tileID = groupID.xy;
    bool needIndirect = false;
    uint2 screenSize = _ScreenSize.xy;
    uint tilesNum;
    tilesNum = (screenSize.x + SCREENSPACE_SHADOWS_TILE_SIZE - 1) / SCREENSPACE_SHADOWS_TILE_SIZE;
    tilesNum *= (screenSize.y + SCREENSPACE_SHADOWS_TILE_SIZE - 1) / SCREENSPACE_SHADOWS_TILE_SIZE;

    uint2 coordBoundLL = SCREENSPACE_SHADOWS_TILE_SIZE * tileID;
    

#if RAYTRACING

    UNITY_UNROLL
    for (int i = 0; i < 4; i++)
    {
        int idx = i * SCREENSPACE_SHADOWS_THREADS + groupIndex;
        uint2 coordSS = uint2(coordBoundLL.x + (idx & 0xf), coordBoundLL.y + (idx >> 4));

        // Reject the sky/background
        float depth = LoadSceneDepth(coordSS);
        if (depth == UNITY_RAW_FAR_CLIP_VALUE)
        {
            _SSDirShadowmapTexture[coordSS] = 1.0;
            _TracedShadowTexture[coordSS] = 1.0;
            _ShadowMomentstexture[coordSS] = float3(1.0, 0, 0);
            continue;
        }

        // Reject non shadow reciver
        float4 gbuffer0 = LOAD_TEXTURE2D_X(_GBuffer0, coordSS);
        uint materialFlags = UnpackMaterialFlags(gbuffer0.a);
        bool materialReceiveShadowsOff = (materialFlags & kMaterialFlagReceiveShadowsOff) != 0;
        if (materialReceiveShadowsOff)
        {
            _SSDirShadowmapTexture[coordSS] = 1.0;
            _TracedShadowTexture[coordSS] = 1.0;
            _ShadowMomentstexture[coordSS] = float3(1.0, 0, 0);
            continue;
        }

        // Need rays/tiles
        if (coordSS.x < screenSize.x && coordSS.y < screenSize.y)
        {
            _SSDirShadowmapTexture[coordSS] = 0.5; // Need Ray Color
            _TracedShadowTexture[coordSS] = 0.5;
            _ShadowMomentstexture[coordSS] = float3(0.5, 0, 0);

            uint rayIndexOffset = 0;
            InterlockedAdd(_ShadowRayIndirectBuffer[0], 1, rayIndexOffset);
            _ShadowRayCoordBuffer[rayIndexOffset] = EncodeRayCoord(coordSS);
        }

        needIndirect = true;
    }

#else // No RAYTRACING blow

    // Sampling shadows
    UNITY_UNROLL
    for (int i = 0; i < 4; i++)
    {
        int idx = i * SCREENSPACE_SHADOWS_THREADS + groupIndex;
        uint2 coordSS = min(uint2(coordBoundLL.x + (idx & 0xf), coordBoundLL.y + (idx >> 4)), uint2(screenSize.x - 1, screenSize.y - 1));

        // Reject the sky/background
        float depth = LoadSceneDepth(coordSS);
        if (depth == UNITY_RAW_FAR_CLIP_VALUE)
        {
            _SSDirShadowmapTexture[coordSS] = 1.0;
            continue;
        }

        // Reject non shadow reciver
        float4 gbuffer0 = LOAD_TEXTURE2D_X(_GBuffer0, coordSS);
        uint materialFlags = UnpackMaterialFlags(gbuffer0.a);
        bool materialReceiveShadowsOff = (materialFlags & kMaterialFlagReceiveShadowsOff) != 0;
        if (materialReceiveShadowsOff)
        {
            _SSDirShadowmapTexture[coordSS] = 1.0;
            continue;
        }

        // Position
        PositionInputs posInput = GetPositionInput(coordSS.xy, _ScreenSize.zw, depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V, uint2(0, 0));
        float3 positionWS = posInput.positionWS;
        half cascadeIndex;
        half cascadeBlend;
        ComputeCascadeIndexAndBlend(positionWS, cascadeIndex, cascadeBlend);
        if (cascadeIndex >= MAX_SHADOW_CASCADES)
        {
            _SSDirShadowmapTexture[coordSS] = 1.0;
            continue;
        }

        float4 shadowCoord = TransformWorldToShadowCoord(positionWS, cascadeIndex);
        float shadowFade = GetMainLightShadowFade(positionWS);

        half shadowQuality = _MainLightShadowParams.y;
        if (shadowQuality < SOFT_SHADOW_QUALITY_HIGH)
        {
            bool hardShadows = shadowQuality <= SOFT_SHADOW_QUALITY_OFF;
            float shadow = hardShadows
                ? SampleHardDirectionalShadow(shadowCoord.xyz, cascadeIndex)
                : SamplePCFDirectionalShadow(shadowCoord.xyz, cascadeIndex, shadowQuality);
            if (cascadeBlend > 0.0)
            {
                half nextCascadeIndex = cascadeIndex + half(1.0);
                float4 nextShadowCoord = TransformWorldToShadowCoord(positionWS, nextCascadeIndex);
                float nextShadow = hardShadows
                    ? SampleHardDirectionalShadow(nextShadowCoord.xyz, nextCascadeIndex)
                    : SamplePCFDirectionalShadow(nextShadowCoord.xyz, nextCascadeIndex, shadowQuality);
                shadow = lerp(shadow, nextShadow, cascadeBlend);
            }

            _SSDirShadowmapTexture[coordSS] = lerp(shadow, 1.0, shadowFade);
            continue;
        }

        float prefilterSampleCount;
        float blockerSampleCount;
        float filterSampleCount;
        GetPCSSSampleCounts(prefilterSampleCount, blockerSampleCount, filterSampleCount);

        float2 noiseJitter = GetShadowNoise(coordSS, shadowCoord.xyz, cascadeIndex);
        bool currentNeedsPCSS;
        float shadow = ClassifyPCSSShadow(shadowCoord.xyz, cascadeIndex, noiseJitter, prefilterSampleCount, currentNeedsPCSS);
        bool nextNeedsPCSS = false;
        if (cascadeBlend > 0.0)
        {
            half nextCascadeIndex = cascadeIndex + half(1.0);
            float4 nextShadowCoord = TransformWorldToShadowCoord(positionWS, nextCascadeIndex);
            // Keep the sampling rotation continuous while blending adjacent cascades.
            float2 nextNoiseJitter = noiseJitter;
            float nextShadow = ClassifyPCSSShadow(nextShadowCoord.xyz, nextCascadeIndex, nextNoiseJitter, prefilterSampleCount, nextNeedsPCSS);
            shadow = lerp(shadow, nextShadow, cascadeBlend);
        }

        needIndirect = needIndirect || currentNeedsPCSS || nextNeedsPCSS;
        _SSDirShadowmapTexture[coordSS] = lerp(shadow, 1.0, shadowFade);
    }

#endif // RAYTRACING

    needIndirect = needIndirect || (_RasterShadowDenoiser != 0);

    // Set group shared.
    if (needIndirect)
    {
        InterlockedAdd(gTileCount, 1);
    }

    GroupMemoryBarrierWithGroupSync();

    // Write per tile data.
    if (groupIndex == 0 && gTileCount > 0)
    {
        uint tileOffset = 0;
        uint prevGroupCnt;
        // We are filling up an indirect argument buffer for DispatchIndirect.
        // The buffer contains {groupCntX, groupCntY, groupCntZ} = {groupCnt, 0, 0}.
        // Current thread contorls 4 pixels.
        InterlockedAdd(g_DispatchIndirectBuffer[0], 4, prevGroupCnt);
        tileOffset = prevGroupCnt / 4; // 4x 8x8 groups per a 16x16 tile
        g_TileList[tileOffset] = EncodeTileIndex(tileID.xy);
    }

}

#elif defined(SHADOW_PCSS)
//--------------------------------------------------------------------------------------------------
// Implementation PCSS shadows
//--------------------------------------------------------------------------------------------------


[numthreads(SCREENSPACE_SHADOWS_GROUP_SIZE, SCREENSPACE_SHADOWS_GROUP_SIZE, 1)]
void PCSS_FILTER(uint3 dispatchThreadId : SV_DispatchThreadID, uint2 groupThreadId : SV_GroupThreadID, uint groupId : SV_GroupID)
{
    uint2 coordSS;
    uint2 tileCoord;
    InitializeDispatchThreadIdFromTileList(groupId, groupThreadId, tileCoord, coordSS);
    coordSS = min(coordSS, (uint2)_ScreenSize.xy - 1);

    if (_PCSSTexture[coordSS] == 0.0 || _PCSSTexture[coordSS] == 1.0)
        return;

    float2 screenUV = coordSS * _ScreenSize.zw + (0.5 * _ScreenSize.zw);
    float depth = LoadSceneDepth(coordSS);

    // Position
    PositionInputs posInput = GetPositionInput(coordSS.xy, _ScreenSize.zw, depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V, uint2(0, 0));
    float3 positionWS = posInput.positionWS;
    half cascadeIndex;
    half cascadeBlend;
    ComputeCascadeIndexAndBlend(positionWS, cascadeIndex, cascadeBlend);
    if (cascadeIndex >= MAX_SHADOW_CASCADES)
    {
        _PCSSTexture[coordSS] = 1.0;
        return;
    }

    float4 shadowCoord = TransformWorldToShadowCoord(positionWS, cascadeIndex);
    float prefilterSampleCount;
    float blockerSampleCount;
    float filterSampleCount;
    GetPCSSSampleCounts(prefilterSampleCount, blockerSampleCount, filterSampleCount);

    float2 noiseJitter = GetShadowNoise(coordSS, shadowCoord.xyz, cascadeIndex);
    float shadow = EvaluatePCSSShadow(shadowCoord.xyz, cascadeIndex, noiseJitter, blockerSampleCount, filterSampleCount);
    if (cascadeBlend > 0.0)
    {
        half nextCascadeIndex = cascadeIndex + half(1.0);
        float4 nextShadowCoord = TransformWorldToShadowCoord(positionWS, nextCascadeIndex);
        // Match the classify pass and avoid mixing two unrelated noise phases.
        float2 nextNoiseJitter = noiseJitter;
        float nextShadow = EvaluatePCSSShadow(nextShadowCoord.xyz, nextCascadeIndex, nextNoiseJitter, blockerSampleCount, filterSampleCount);
        shadow = lerp(shadow, nextShadow, cascadeBlend);
    }

    _PCSSTexture[coordSS] = lerp(shadow, 1.0, GetMainLightShadowFade(positionWS));

}

#elif defined(CONTACT_SHADOWS)
//--------------------------------------------------------------------------------------------------
// Short-range screen-space contact shadows
//--------------------------------------------------------------------------------------------------

[numthreads(8, 8, 1)]
void ContactShadows(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 coordSS = dispatchThreadId.xy;
    uint2 screenSize = (uint2)_ScreenSize.xy;
    if (any(coordSS >= screenSize))
        return;

    float deviceDepth = LoadSceneDepth(coordSS);
    if (deviceDepth == UNITY_RAW_FAR_CLIP_VALUE || _SSDirShadowmapTexture[coordSS] <= 0.001)
        return;

    float4 gbuffer0 = LOAD_TEXTURE2D_X(_GBuffer0, coordSS);
    uint materialFlags = UnpackMaterialFlags(gbuffer0.a);
    if ((materialFlags & kMaterialFlagReceiveShadowsOff) != 0)
        return;

    float2 screenUV = TransformCoordSSToScreenUV(coordSS, _ScreenSize);
    float3 positionWS = ComputeWorldSpacePosition(screenUV, deviceDepth, UNITY_MATRIX_I_VP);
    float cameraDistance = distance(positionWS, _WorldSpaceCameraPos);
    float maxDistance = _ContactShadowParams0.y;
    float fadeDistance = max(_ContactShadowParams0.z, 1e-4);
    float distanceFade = 1.0 - saturate((cameraDistance - (maxDistance - fadeDistance)) / fadeDistance);
    if (distanceFade <= 0.0)
        return;

    float3 normalWS = normalize(UnpackNormal(LOAD_TEXTURE2D_X(_GBuffer2, coordSS).xyz));
    float3 lightDirectionWS = normalize(g_DirectionalLightDatas[0].lightDirection);
    if (dot(normalWS, lightDirectionWS) <= 0.0)
        return;

    float rayLength = _ContactShadowParams0.x;
    float thickness = _ContactShadowParams0.w;
    float normalBias = _ContactShadowParams1.y;
    float jitterAmount = _ContactShadowParams1.z;
    float rayFadeStart = _ContactShadowParams1.w;

    // Screen-space blue noise turns fixed-step ray bands into high-frequency noise.
    // High remains static because its bound STBN frame is zero; Ultra is temporally filtered.
    float noise = GetSpatiotemporalBlueNoiseVec2(coordSS).x;
    float sampleOffset = lerp(0.5, noise, jitterAmount);

    float contactOcclusion = 0.0;
    float3 rayOriginWS = positionWS + normalWS * normalBias;
    UNITY_LOOP
    for (int sampleIndex = 0; sampleIndex < _ContactShadowSampleCount; sampleIndex++)
    {
        float rayT = (sampleIndex + sampleOffset) / _ContactShadowSampleCount;
        float3 rayPositionWS = rayOriginWS + lightDirectionWS * (rayT * rayLength);
        float3 rayPositionNDC = ComputeNormalizedDeviceCoordinatesWithZ(rayPositionWS, UNITY_MATRIX_VP);
        if (any(rayPositionNDC.xy <= 0.0) || any(rayPositionNDC.xy >= 1.0))
            break;

        uint2 sampleCoordSS = min((uint2)(rayPositionNDC.xy * screenSize), screenSize - 1);
        float sceneDepth = LoadSceneDepth(sampleCoordSS);
        if (sceneDepth == UNITY_RAW_FAR_CLIP_VALUE)
            continue;

        float rayEyeDepth = LinearEyeDepth(rayPositionNDC.z, _ZBufferParams);
        float sceneEyeDepth = LinearEyeDepth(sceneDepth, _ZBufferParams);
        float depthDelta = rayEyeDepth - sceneEyeDepth;
        if (depthDelta <= 0.0 || depthDelta >= thickness)
            continue;

        float hitStrength = 1.0 - saturate(depthDelta / thickness);
        float rayFade = 1.0 - saturate((rayT - rayFadeStart) / max(1.0 - rayFadeStart, 1e-4));
        float2 edgePixels = min(rayPositionNDC.xy, 1.0 - rayPositionNDC.xy) * _ScreenSize.xy;
        float edgeFade = saturate(min(edgePixels.x, edgePixels.y) * 0.25);
        contactOcclusion = max(contactOcclusion, hitStrength * rayFade * edgeFade);
    }

    float contactVisibility = 1.0 - contactOcclusion * distanceFade * _ContactShadowParams1.x;
    _SSDirShadowmapTexture[coordSS] = min(_SSDirShadowmapTexture[coordSS], contactVisibility);
}

#elif defined(SHADOW_BILATERAL_FILTER)
//--------------------------------------------------------------------------------------------------
// Implementation Bilateral Filter
//--------------------------------------------------------------------------------------------------

groupshared float4 localNormalDepth[256];
groupshared float localColor[256];

struct CoordData {
    float3  normal;
    float   depth;
    float   color;
};


#define GAUSSIAN_WEIGHT_COUNT (9)
static const float gaussianWeight[GAUSSIAN_WEIGHT_COUNT] = {0.02763055, 0.06628224, 0.1238315, 0.1801738, 0.2041637, 0.1801738, 0.1238315, 0.06628224, 0.02763055};

struct BilateralData
{
    float3 position;
    float depth;
    float3 normal;
};

float GetEdegStoppingNormalWeight(float3 normal1, float3 normal2)
{
    return pow(max(dot(normal1, normal2), 0.0f), 32.0f);
}

float GetEdgeStoppingDepthWeight(float centerDepth, float neighDepth)
{
    return exp(-abs(centerDepth - neighDepth) * 4.0);
}

// TODO: Actually we should use plane base depth weight like SVGF.
float ComputeBilateralWeight(BilateralData center, BilateralData neigh)
{
    // Depth
    float depthWeight = GetEdgeStoppingDepthWeight(center.depth, neigh.depth);

    // Normal
    float normalWeight = GetEdegStoppingNormalWeight(center.normal, neigh.normal);

    return depthWeight * normalWeight;
}

CoordData LoadFromGroupSharedMemory(uint2 gThreadId)
{
    #if FINAL_PASS
    gThreadId.y += 4;
    #else
    gThreadId.x += 4;
    #endif

    uint localID = gThreadId.x + 16 * gThreadId.y;
    float4 encodedNormalDepth = localNormalDepth[localID];

    CoordData neighborSample;
    ZERO_INITIALIZE(CoordData, neighborSample);
    neighborSample.normal = encodedNormalDepth.xyz;
    neighborSample.depth = encodedNormalDepth.w;
    neighborSample.color = localColor[localID];
    
    return neighborSample;
}

void StoreInGroupSharedMemory(uint2 gThreadId, CoordData inData)
{
    #if FINAL_PASS
    gThreadId.y += 4;
    #else
    gThreadId.x += 4;
    #endif

    uint localID = gThreadId.x + 16 * gThreadId.y;
    localNormalDepth[localID] = float4(inData.normal.xyz, inData.depth);
    localColor[localID] = inData.color;
}

void LoadCoordData(int2 coordSS, out CoordData outData)
{
    ZERO_INITIALIZE(CoordData, outData);
    if (coordSS.x >= _ScreenSize.x || coordSS.y >= _ScreenSize.y || coordSS.x < 0.0 || coordSS.y < 0.0)
    {
        outData.depth = UNITY_RAW_FAR_CLIP_VALUE;
        return;
    }

    float deviceDepth = LoadSceneDepth(coordSS);
    if (deviceDepth == UNITY_RAW_FAR_CLIP_VALUE)
    {
        outData.depth = UNITY_RAW_FAR_CLIP_VALUE;
        return;
    }

    float4 normalGBuffer = LOAD_TEXTURE2D_X(_GBuffer2, coordSS);
    float3 normalWS = normalize(UnpackNormal(normalGBuffer.xyz));

    outData.normal = normalWS;
    outData.depth = LinearEyeDepth(deviceDepth, _ZBufferParams);
    outData.color = _BilateralTexture[coordSS];
}

void InitializeGroupSharedMemory(uint2 dThreadId, uint2 gThreadId)
{
    #if FINAL_PASS
    uint2 offset[2] = {uint2(0, -4), uint2(0, 4)};
    #else
    uint2 offset[2] = {uint2(-4, 0), uint2(4, 0)};
    #endif

    CoordData coordData[2];
    for (int i = 0; i < 2; i++)
    {
        LoadCoordData(dThreadId + offset[i], coordData[i]);
    }

    for (int j = 0; j < 2; j++)
    {
        StoreInGroupSharedMemory(gThreadId + offset[j], coordData[j]);
    }
}


[numthreads(SCREENSPACE_SHADOWS_GROUP_SIZE, SCREENSPACE_SHADOWS_GROUP_SIZE, 1)]
void BILATERAL_FILTER(uint3 dispatchThreadId : SV_DispatchThreadID, uint2 groupThreadId : SV_GroupThreadID, uint groupId : SV_GroupID)
{
    uint2 coordSS;
    uint2 tileCoord;
    InitializeDispatchThreadIdFromTileList(groupId, groupThreadId, tileCoord, coordSS);
    // coordSS = dispatchThreadId.xy;

    uint2 coordGroup = groupThreadId.xy;
    InitializeGroupSharedMemory(coordSS, coordGroup);

    GroupMemoryBarrierWithGroupSync();

    CoordData center = LoadFromGroupSharedMemory(coordGroup);
    float2 screenUV = coordSS * _ScreenSize.zw + (0.5 * _ScreenSize.zw);

    if (center.depth == UNITY_RAW_FAR_CLIP_VALUE)
        return;

    // Position
    PositionInputs posInput = GetPositionInput(coordSS.xy, _ScreenSize.zw, center.depth, UNITY_MATRIX_I_VP, UNITY_MATRIX_V, uint2(0, 0));

    BilateralData centerData;
    ZERO_INITIALIZE(BilateralData, centerData);
    {
        centerData.normal = center.normal;
        centerData.depth = center.depth;
    }


    float colorSum = center.color * gaussianWeight[4];
    float weightSum = gaussianWeight[4];

    // TODO: Actually far distance pixels should have smaller radius.
    int radius = 4;

    #if FINAL_PASS
        const int2 passIncr = int2(0, 1);
    #else
        const int2 passIncr = int2(1, 0);
    #endif

    int2 neighCoordGroup = coordGroup - radius * passIncr;
    for (int r = -radius; r <= radius; r++, neighCoordGroup += passIncr)
    {
        if (r == 0)
            continue;
        CoordData neigh = LoadFromGroupSharedMemory(neighCoordGroup);
        if (neigh.depth == UNITY_RAW_FAR_CLIP_VALUE)
            continue;

        BilateralData neighData;
        ZERO_INITIALIZE(BilateralData, neighData);
        {
            neighData.normal = neigh.normal;
            neighData.depth = neigh.depth;
        }

        float bilateralWeight = ComputeBilateralWeight(centerData, neighData);
        float weight = gaussianWeight[r + 4] * bilateralWeight;

        colorSum += weight * neigh.color;
        weightSum += weight;
    }

    _BilateralTexture[coordSS] = colorSum / weightSum;
}

#endif
